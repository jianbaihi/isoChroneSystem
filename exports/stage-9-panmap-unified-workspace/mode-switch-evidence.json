    "invalidQueryFallsBack": true,
    "invalidQueryObservedMode": "ordinary"
  },
  "ordinaryCapabilities": {
    "sharedWorkspace": true,
    "dataSummary": true,
    "layoutPresets": true,
    "densityPresets": true,
    "commonStyleControls": true,
    "applyAndReset": true,
    "metricsPanel": false,
    "comparison": false,
    "algorithmParameters": false,
    "experimentExport": false
  },
  "researchCapabilities": {
    "sharedWorkspace": true,
    "dataSummary": true,
    "layoutPresets": true,
    "densityPresets": true,
    "commonStyleControls": true,
    "metricsPanel": true,
    "comparison": true,
    "algorithmParameters": true,
    "experimentExport": true,
    "frozenBaselineNotice": true
  },
  "sharedDom": {
    "controlPanelCount": 1,
    "canvasCount": 1,
    "controlPanel": "#panmapControlPanel",
    "canvas": ".panmap-art"
  },
