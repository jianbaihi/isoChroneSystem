# Server runtime
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5500

# Development defaults to online providers. Mock is accepted only with APP_ENV=test.
ANALYSIS_PROVIDER=ors
ALLOW_MOCK_FALLBACK=false
ALLOW_NETWORK=true
ORS_BASE_URL=https://api.heigit.org/openrouteservice
ORS_API_KEY=
ORS_TIMEOUT_SECONDS=15
POI_PROVIDER=ors_remote
POI_DATABASE_PATH=data/generated/poi.sqlite3
POI_MAX_RESULTS=600
POI_MAX_CANDIDATES=50000
POI_MIN_CONFIDENCE=

# Multi-region POI routing (keys stay server-side)
POI_REGION_MODE=auto
POI_PROVIDER_CN=amap
POI_PROVIDER_GLOBAL=foursquare
POI_ALLOW_PROVIDER_FALLBACK=false
AMAP_POI_ENABLED=false
AMAP_WEB_SERVICE_KEY=
AMAP_POI_BASE_URL=https://restapi.amap.com/v5/place
AMAP_POI_AUTO_REQUEST_LIMIT=20
AMAP_POI_MAX_CONCURRENCY=2
AMAP_POI_MAX_SPLIT_DEPTH=3
AMAP_POI_MIN_CELL_AREA_KM2=0.25
AMAP_POI_MAX_PAGES_PER_JOB=4
AMAP_POI_MIN_REQUEST_INTERVAL_SECONDS=1.05
FOURSQUARE_POI_ENABLED=false
FOURSQUARE_SERVICE_KEY=
FOURSQUARE_POI_BASE_URL=https://places-api.foursquare.com
FOURSQUARE_PLACES_API_VERSION=2025-06-17

# OpenPOIService integration (uses the server-side ORS key; never expose it to the browser)
ORS_POI_BASE_URL=https://api.openrouteservice.org
ORS_POI_PATH=/pois
ORS_PROFILE=driving-car
ORS_ISOCHRONE_RANGES_SECONDS=600,1200,1800
ORS_POI_QUERY_STRATEGY=outer-isochrone-grid
ORS_POI_GRID_SIZE_METERS=6000
ORS_POI_MAX_CELL_AREA_KM2=45
ORS_POI_LIMIT_PER_CELL=2000
ORS_POI_MAX_REQUESTS_PER_ANALYSIS=40
ORS_POI_MAX_CONCURRENCY=2
ORS_POI_TIMEOUT_SECONDS=30
ORS_CACHE_DIR=data/generated/ors-cache
ORS_CACHE_TTL_SECONDS=604800
ORS_CACHE_STALE_IF_ERROR=true
